@model List<SearchingForItems.Models.GameLevel>

@{
    ViewData["Title"] = "Выбор локации";
    Layout = null;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background-color: #141C30;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0;
        padding: 0;
        height: 100vh;
        font-family: 'Press Start 2P', cursive;
    }

    .main-container {
        position: relative;
        width: 420px;
        height: 740px;
        background-image: url('/images/level-page-bg.jpg');
        background-size: cover;
        background-position: center;

        border-radius: 4px;
        overflow: hidden;
    }

    .settings-btns {
        position: absolute;
        top: 25px;
        right: 25px;
        display: flex;
        gap: 12px;
        z-index: 10;
    }

    .setting-btn {
        width: 38px;
        aspect-ratio: 1 / 1;
        border: none;
        background-color: transparent;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
        padding: 0;
        transition: transform 0.1s ease, filter 0.1s ease;
    }

    .sound-btn {
        background-image: url('/images/sound-btn.png');
    }

    .music-btn {
        background-image: url('/images/music-btn.png');
    }

    .setting-btn:hover {
        transform: scale(1.08);
        filter: brightness(1.1);
    }

    .setting-btn:active {
        transform: translateY(2px) scale(1.02);
        filter: brightness(0.90);
    }

    .levels-cards {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        width: 90%;
        z-index: 1;
    }

    .level-card {
        flex: 1;
        aspect-ratio: 3 / 4;
        border: none;
        background-color: transparent;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
        padding: 0;
        transition: transform 0.1s ease, filter 0.1s ease;
    }

    .level-kitchen {
        background-image: url('/images/levelSelection/kitchen.png');
    }

    .level-livingroom {
        background-image: url('/images/levelSelection/living-room.png');
    }

    .level-yard {
        background-image: url('/images/levelSelection/yard.png');
    }

    .level-card:hover {
        transform: scale(1.05);
        filter: brightness(1.1);
    }

    .level-card:active {
        transform: translateY(3px) scale(1.02);
        filter: brightness(0.9);
    }

    .menu-btns {
        position: absolute;
        bottom: 12%;
        left: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .menu-btn {
        display: block;
        width: 55%;
        aspect-ratio: 530 / 106;
        border: none;
        background-color: transparent;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
        padding: 0;
        transition: transform 0.1s ease, filter 0.1s ease;
    }

    .back-btn {
        background-image: url('/images/back-btn.png');
    }

    .menu-btn:hover {
        transform: scale(1.04);
        filter: brightness(1.1);
    }

    .menu-btn:active {
        transform: translateY(4px) scale(1.02);
        filter: brightness(0.90);
    }
</style>

<div class="main-container">
    <div class="settings-btns">
        <button class="setting-btn sound-btn" aria-label="Звуковые эффекты"></button>
        <button class="setting-btn music-btn" aria-label="Фоновая музыка"></button>
    </div>

    <div class="levels-cards">
        <a asp-controller="Game" asp-action="Index" asp-route-id="1" class="level-card level-kitchen"></a>
        <a class="level-card level-livingroom"></a>
        <a class="level-card level-yard"></a>
    </div>

    <div class="menu-btns">
        <a href="/" class="menu-btn back-btn" aria-label="Назад"></a>
    </div>
</div>