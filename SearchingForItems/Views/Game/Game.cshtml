@model SearchingForItems.Models.GameLevel

@{
    ViewData["Title"] = "Тайная комната";
}

<style>
    .game-area {
        position: relative;
        width: 100%;
        height: 500px;
        background-image: url('@Model.BackgroundImageUrl');
        background-size: cover;
        border: 5px solid #333;
        cursor: pointer;
    }

    .hidden-item {
        position: absolute;
        cursor: pointer;
        transition: transform 0.2s;
        width: 50px;
    }

        .hidden-item:hover {
            transform: scale(1.2);
        }

    .found {
        display: none;
    }

    .word-found {
        text-decoration: line-through;
        color: red;
    }
</style>

<div class="container">
    <h2>@Model.Title</h2>

    <div class="row">
        <div class="col-md-9">
            <div class="game-area" id="gameField" onclick="onBackgroundClick(event)">
                @foreach (var word in Model.Words)
                {
                    <img src="@word.ImageUrl"
                         class="hidden-item"
                         style="top: @word.Top%; left: @word.Left%;"
                         data-id="@word.Id"
                         onclick="onItemClick(event, this, '@word.Id')" />
                }
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel">
                <h4>Рæстæг: <span id="timer">60</span></h4>
                <h4>Счет: <span id="score">0</span></h4>
                <hr />
                <h5>Саттæгтæ (Найти):</h5>
                <ul id="wordList">
                    @foreach (var word in Model.Words)
                    {
                        <li id="li-@word.Id">@word.Ossetian</li>
                    }
                </ul>
                <button class="btn btn-warning" onclick="togglePause()">Паузæ</button>
            </div>
        </div>
    </div>
</div>

<script>
    let score = 0;
    let isPaused = false;
    let timeLeft = 60;

    async function callControllerProcessClick(isRight) {
        try {
            const response = await fetch('/Game/ProcessClick', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(isRight) 
            });

            if (response.ok) {
                const data = await response.json();
                score = data.newScore;
                document.getElementById('score').innerText = score;
            }
        } catch (error) {
            console.error('Ошибка:', error);
        }
    }

    async function onItemClick(event, element, id) {
        event.stopPropagation();

        if(isPaused) return;
        if(element.classList.contains('found')) return;

        await callControllerProcessClick(true);

        element.classList.add('found');
        document.getElementById('li-' + id).classList.add('word-found');
    }

    async function onBackgroundClick(event) {
        if(event.target.id !== 'gameField') return;
        if(isPaused) return;
        await callControllerProcessClick(false);
    }

    setInterval(function() {
        if(!isPaused && timeLeft > 0) {
            timeLeft--;
            document.getElementById('timer').innerText = timeLeft;
        }
    }, 1000);

    function togglePause() {
        isPaused = !isPaused;
        alert(isPaused ? "Паузæ" : "Хъазт адарддæр кæн");
    }
</script>