@model SearchingForItems.Models.GameLevel

@{
    ViewData["Title"] = "Тайная комната";
}

<style>
    .game-area {
        position: relative;
        width: 100%;
        height: 500px;
        background-image: url('@Model.BackgroundImageUrl');
        background-size: cover;
        border: 5px solid #333;
    }
    .hidden-item {
        position: absolute;
        cursor: pointer;
        transition: transform 0.2s;
        width: 50px;
    }
    .hidden-item:hover { transform: scale(1.2); }
    .found { display: none; }
    .word-found { text-decoration: line-through; color: red; }
</style>

<div class="container">
    <h2>@Model.Title</h2>
    
    <div class="row">
        <div class="col-md-9">
            <div class="game-area" id="gameField">
                @foreach (var word in Model.Words)
                {
                    <img src="@word.ImageUrl"
                         class="hidden-item"
                         style="top: @word.Top%; left: @word.Left%;"
                         onclick="checkItem(this, '@word.Id')" />
                }
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel">
                <h4>Рæстæг: <span id="timer">60</span></h4>
                <h4>Счет: <span id="score">0</span></h4>
                <hr />
                <h5>Саттæгтæ (Найти):</h5>
                <ul id="wordList">
                    @foreach (var word in Model.Words)
                    {
                        <li id="li-@word.Id">@word.Ossetian</li>
                    }
                </ul>
                <button class="btn btn-warning" onclick="togglePause()">Паузæ</button>
            </div>
        </div>
    </div>
</div>

<script>
    let score = 0;
    let isPaused = false;
    let timeLeft = 60;

    function checkItem(element, id) {
        if(isPaused) return;

        element.classList.add('found');
        document.getElementById('li-' + id).classList.add('word-found');
        
        score += 10;
        document.getElementById('score').innerText = score;
    }

    setInterval(function() {
        if(!isPaused && timeLeft > 0) {
            timeLeft--;
            document.getElementById('timer').innerText = timeLeft;
        }
    }, 1000);

    function togglePause() {
        isPaused = !isPaused;
        alert(isPaused ? "Паузæ" : "Хъазт адарддæр кæн");
    }
</script>