@model SearchingForItems.Models.GameLevel

@{
    // переделать тайтл
    ViewData["Title"] = "Тайная комната";
    Layout = null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
    * {
        box-sizing: border-box;
        user-select: none;
    }

    body {
        background-color: #141C30;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0;
        padding: 0;
        height: 100vh;
        font-family: 'Press Start 2P', cursive;
    }


    .main-container {
        position: relative;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        padding: 5px;
        height: 95vh;
        max-width: 90vw;
    }
    .top-bar {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
        color: #FB8714;
        font-size: 14px;
        text-transform: uppercase;
    }
    .game-wrapper {
        position: relative;
        height: 78vh;
        aspect-ratio: 1256 / 2096;
        margin: 0 auto;
    }
    .game-area {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        background-image: url('@Model.BackgroundImageUrl');
        background-size: 100% 100%;
        background-position: center;
        cursor: pointer;
    }
    .game-frame {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/images/lvl-frames.png');
        background-size: 100% 100%;
        image-rendering: pixelated;
        z-index: 10;
        pointer-events: none;
    }

    .hidden-item {
        position: absolute;
        cursor: pointer;
        transition: filter 0.3s ease, opacity 0.3s ease;
        width: 4%;
        z-index: 5;
    }

    .found {
        filter: grayscale(100%);
        pointer-events: none;
    }

    .words-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 20px;
    }

    .word-btn {
        border: 3px solid #FB8714;
        background-color: #FDC52C;
        color: #141414;
        font-family: 'Press Start 2P', cursive;
        font-size: 10px;
        padding: 8px 5px;
        text-align: center;
        line-height: 1.2;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .word-found {
        background-color: #FB8714;
        color: #141C30;
    }
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.7);
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background-color: white;
        padding: 30px;
        border-radius: 15px;
        text-align: center;
        min-width: 300px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.3);
    }

    .modal-content h2 {
        color: #28a745;
        margin-bottom: 20px;
    }

    .modal-content p {
        font-size: 18px;
        margin: 10px 0;
    }

    .modal-content .final-score {
        font-size: 24px;
        font-weight: bold;
        color: #ffc107;
        margin: 15px 0;
    }

    .modal-buttons {
        margin-top: 20px;
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .modal-buttons a {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        transition: background-color 0.3s;
        text-decoration: none;
    }

    .next-level-btn {
        background-color: #28a745;
        color: white;
    }

    .next-level-btn:hover {
        background-color: #218838;
        color: white;
    }

    .restart-btn {
        background-color: #ffc107;
        color: #333;
    }

    .restart-btn:hover {
        background-color: #e0a800;
        color: #333;
    }
    /* ================================================================= */
    .setting-btn {
        position: relative;
        width: 40px;
        aspect-ratio: 1 / 1;
        border: none;
        background-color: transparent;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
        padding: 0;
        transition: transform 0.1s ease, filter 0.1s ease;
    }

    .setting-btn:hover {
        transform: scale(1.08);
        filter: brightness(1.1);
    }

    .setting-btn:active {
        transform: translateY(2px) scale(1.02);
        filter: brightness(0.90);
    }

    .pause-btn {
        background-image: url('/images/buttons/pause-btn.png');
    }

    .music-btn {
        background-image: url('/images/buttons/music-btn.png');
    }

    .music-btn.off::after {
        content: '';
        position: absolute;
        width: 120%;
        height: 3px;
        background-color: #d11e1e;
        top: 50%;
        left: -10%;
        transform: rotate(-45deg);
        border: 2px solid #141414;
        border-radius: 2px;
    }

    .pause-content {
        background-image: url('/images/pause-modal.png');
        background-size: 100% 100%;
        background-repeat: no-repeat;
        background-color: transparent;
        width: 350px;
        height: 300px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 25px;
        padding-top: 50px;
        box-shadow: none;
        position: relative;
    }

    .pause-text-btn {
        font-family: 'Press Start 2P', cursive;
        font-size: 14px;
        color: #141414;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.2s ease, color 0.2s;
        text-transform: uppercase;
        background: none;
        border: none;
    }

    .pause-text-btn:hover {
        color: #FB8714;
        transform: scale(1.05);
    }

    .pause-btn-floating {
        position: absolute;
        top: 25px;
        right: 25px;
        z-index: 20;
        width: 38px;
        height: 38px;
    }
   
</style>

<div class="main-container">
    <div class="top-bar">
        <div>Рæстæг: <span id="timer">60</span></div>
        <div>Счет: <span id="score">0</span></div>
    </div>

    <div class="game-wrapper">
        <div class="game-area" id="gameField" onclick="onBackgroundClick(event)">
            @foreach (var word in Model.Words)
            {
                <img src="@word.ImageUrl"
                     class="hidden-item"
                     style="top: @word.Top%; left: @word.Left%; width: @word.Width%;"
                     data-id="@word.Id"
                     onclick="onItemClick(event, this, '@word.Id')" />
            }
        </div>
        <div class="game-frame"></div>
        <button class="setting-btn pause-btn pause-btn-floating" onclick="togglePause()" aria-label="Пауза"></button>
    </div>

    <div class="words-grid" id="wordList">
        @foreach (var word in Model.Words)
        {
            <div class="word-btn" id="li-@word.Id">@word.Ossetian</div>
        }
    </div>
</div>

<div id="winModal" class="modal">
    <div class="modal-content">
        <h2>🎉 ПОБЕДА! 🎉</h2>
        <p>Вы нашли все предметы!</p>
        <p>Ваш счет:</p>
        <div class="final-score" id="finalScore">0</div>
        <div class="modal-buttons">
            @if (Model.Id<3) {
                <a href="@Url.Action("Index", "Game", new { id = Model.Id + 1 })"
                   class="next-level-btn">
                    ➡ Следующий уровень
                </a>
            }
                <a href="@Url.Action("Index", "Game", new { id = Model.Id })"
                   class="restart-btn">
                    🔄 Переиграть
                </a>
        </div>
    </div>
</div>

<div id="pauseModal" class="modal">
    <div class="pause-content">
        <button id="toggleMusic" class="setting-btn music-btn off" aria-label="Фоновая музыка"></button>

        <button class="pause-text-btn" onclick="togglePause()">Продолжить</button>
        <a href="/" class="pause-text-btn">Главное меню</a>
    </div>
</div>

<audio id="bgMenuMusic" loop>
    <source src="/audio/menu-theme.mp3" type="audio/mpeg">
</audio>

<script>
    let score = 0;
    let isPaused = false;
    let timeLeft = 60;
    let totalItems = @Model.Words.Count;
    let foundItems = 0;
    let timerInterval;

    async function openWinModal() {
        await fetch('/Game/AddPointsUser?score=' + score);
        const modal = document.getElementById('winModal');
        const finalScoreSpan = document.getElementById('finalScore');
        finalScoreSpan.innerText = score;
        modal.style.display = 'flex';
    }

    function closeWinModal() {
        const modal = document.getElementById('winModal');
        modal.style.display = 'none';
    }

    async function callControllerProcessClick(isRight) {
        try {
            const response = await fetch('/Game/ProcessClick', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(isRight)
            });

            if (response.ok) {
                const data = await response.json();
                score = data.newScore;
                document.getElementById('score').innerText = score;
            }
        } catch (error) {
            console.error('Ошибка:', error);
        }
    }

    function checkWinCondition() {
        if (foundItems === totalItems) {
            clearInterval(timerInterval);
            openWinModal();
        }
    }

    async function onItemClick(event, element, id) {
        event.stopPropagation();

        if(isPaused) return;
        if(element.classList.contains('found')) return;

        await callControllerProcessClick(true);

        element.classList.add('found');
        document.getElementById('li-' + id).classList.add('word-found');
        foundItems++;

        checkWinCondition();
    }

    async function onBackgroundClick(event) {
        if(event.target.id !== 'gameField') return;
        if(isPaused) return;
        await callControllerProcessClick(false);
    }

    function startTimer() {
        if (timerInterval) clearInterval(timerInterval);

        timerInterval = setInterval(function() {
            if(!isPaused && timeLeft > 0) {
                timeLeft--;
                document.getElementById('timer').innerText = timeLeft;

                if (timeLeft === 0) {
                    clearInterval(timerInterval);
                    alert("Время вышло! Игра окончена.");
                }
            }
        }, 1000);
    }

    function togglePause() {
        isPaused = !isPaused;
        const pauseModal = document.getElementById('pauseModal');

        pauseModal.style.display = isPaused ? 'flex' : 'none';
    }

    document.addEventListener('DOMContentLoaded', function() {
        const musicGame = document.getElementById('bgMenuMusic');
        const musicGameBtn = document.getElementById('toggleMusic');

        if(musicGame && musicGameBtn) {
            musicGame.volume = 0.1;

            musicGameBtn.addEventListener('click', function() {
                if (musicGame.paused) {
                    musicGame.play();
                    musicGameBtn.classList.remove('off');
                } else {
                    musicGame.pause();
                    musicGameBtn.classList.add('off');
                }
            });
        }
    });

   
    startTimer();
</script>