@model SearchingForItems.Models.GameLevel

@{
    ViewData["Title"] = "Тайная комната";
}

<style>
    .game-area {
        position: relative;
        width: 100%;
        height: 500px;
        background-image: url('@Model.BackgroundImageUrl');
        background-size: cover;
        border: 5px solid #333;
        cursor: pointer;
    }

    .hidden-item {
        position: absolute;
        cursor: pointer;
        transition: transform 0.2s;
        width: 50px;
    }

        .hidden-item:hover {
            transform: scale(1.2);
        }

    .found {
        display: none;
    }

    .word-found {
        text-decoration: line-through;
        color: red;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.7);
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background-color: white;
        padding: 30px;
        border-radius: 15px;
        text-align: center;
        min-width: 300px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.3);
    }

        .modal-content h2 {
            color: #28a745;
            margin-bottom: 20px;
        }

        .modal-content p {
            font-size: 18px;
            margin: 10px 0;
        }

        .modal-content .final-score {
            font-size: 24px;
            font-weight: bold;
            color: #ffc107;
            margin: 15px 0;
        }

    .modal-buttons {
        margin-top: 20px;
        display: flex;
        gap: 10px;
        justify-content: center;
    }

        .modal-buttons a {
            display: inline-block;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            transition: background-color 0.3s;
            text-decoration: none;
        }

    .next-level-btn {
        background-color: #28a745;
        color: white;
    }

        .next-level-btn:hover {
            background-color: #218838;
            color: white;
        }

    .restart-btn {
        background-color: #ffc107;
        color: #333;
    }

        .restart-btn:hover {
            background-color: #e0a800;
            color: #333;
        }
</style>

<div class="container">
    <h2>@Model.Title</h2>

    <div class="row">
        <div class="col-md-9">
            <div class="game-area" id="gameField" onclick="onBackgroundClick(event)">
                @foreach (var word in Model.Words)
                {
                    <img src="@word.ImageUrl"
                         class="hidden-item"
                         style="top: @word.Top%; left: @word.Left%;"
                         data-id="@word.Id"
                         onclick="onItemClick(event, this, '@word.Id')" />
                }
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel">
                <h4>Рæстæг: <span id="timer">60</span></h4>
                <h4>Счет: <span id="score">0</span></h4>
                <hr />
                <h5>Саттæгтæ (Найти):</h5>
                <ul id="wordList">
                    @foreach (var word in Model.Words)
                    {
                        <li id="li-@word.Id">@word.Ossetian</li>
                    }
                </ul>
                <button class="btn btn-warning" onclick="togglePause()">Паузæ</button>
            </div>
        </div>
    </div>
</div>

<div id="winModal" class="modal">
    <div class="modal-content">
        <h2>🎉 ПОБЕДА! 🎉</h2>
        <p>Вы нашли все предметы!</p>
        <p>Ваш счет:</p>
        <div class="final-score" id="finalScore">0</div>
        <div class="modal-buttons">
            @if (Model.Id<3) {
                <a href="@Url.Action("Index", "Game", new { id = Model.Id + 1 })"
                   class="next-level-btn">
                    ➡ Следующий уровень
                </a>
            }
                <a href="@Url.Action("Index", "Game", new { id = Model.Id })"
                   class="restart-btn">
                    🔄 Переиграть
                </a>
        </div>
    </div>
</div>

<script>
    let score = 0;
    let isPaused = false;
    let timeLeft = 60;
    let totalItems = @Model.Words.Count;
    let foundItems = 0;
    let timerInterval;

    function openWinModal() {
        const modal = document.getElementById('winModal');
        const finalScoreSpan = document.getElementById('finalScore');
        finalScoreSpan.innerText = score;
        modal.style.display = 'flex';
    }

    function closeWinModal() {
        const modal = document.getElementById('winModal');
        modal.style.display = 'none';
    }

    async function callControllerProcessClick(isRight) {
        try {
            const response = await fetch('/Game/ProcessClick', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(isRight)
            });

            if (response.ok) {
                const data = await response.json();
                score = data.newScore;
                document.getElementById('score').innerText = score;
            }
        } catch (error) {
            console.error('Ошибка:', error);
        }
    }

    function checkWinCondition() {
        if (foundItems === totalItems) {
            clearInterval(timerInterval);
            openWinModal();
        }
    }

    async function onItemClick(event, element, id) {
        event.stopPropagation();

        if(isPaused) return;
        if(element.classList.contains('found')) return;

        await callControllerProcessClick(true);

        element.classList.add('found');
        document.getElementById('li-' + id).classList.add('word-found');
        foundItems++;

        checkWinCondition();
    }

    async function onBackgroundClick(event) {
        if(event.target.id !== 'gameField') return;
        if(isPaused) return;
        await callControllerProcessClick(false);
    }

    function startTimer() {
        if (timerInterval) clearInterval(timerInterval);

        timerInterval = setInterval(function() {
            if(!isPaused && timeLeft > 0) {
                timeLeft--;
                document.getElementById('timer').innerText = timeLeft;

                if (timeLeft === 0) {
                    clearInterval(timerInterval);
                    alert("Время вышло! Игра окончена.");
                }
            }
        }, 1000);
    }

    function togglePause() {
        isPaused = !isPaused;
        alert(isPaused ? "Паузæ" : "Хъазт адарддæр кæн");
    }

   
    startTimer();
</script>