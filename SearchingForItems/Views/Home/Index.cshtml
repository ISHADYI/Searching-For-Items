@page
@model dynamic
@{
    Layout = null;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    /* Сброс стилей для чистоты */
    * {
        box-sizing: border-box;
    }

    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        background-color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .main-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        position: relative;
        padding: 20px;
    }

    .button-group {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 100%;
        max-width: 300px;
    }

    /* ОБНОВЛЕННЫЙ СТИЛЬ КНОПОК */
    .btn-main {
        display: block;
        width: 100%;
        padding: 15px 0;
        font-size: 18px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
        text-transform: lowercase;
        border-radius: 0; /* Прямые углы как на картинке */
    }

    /* Специфичный стиль для зеленой кнопки "играть" */
    .btn-play {
        background-color: #2ecc71; /* Яркий зеленый */
        color: #000000;
        border: none; /* Убираем черную рамку */
    }

        .btn-play:hover {
            background-color: #1e8f4f; /* Чуть темнее при наведении */
        }

    /* Специфичный стиль для белой кнопки "войти" */
    .btn-login {
        background-color: #ffffff;
        color: #000000;
        border: 2px solid #000000; /* Рамка 2px, как просили */
    }

        .btn-login:hover {
            background-color: #2e2e2e;
            color: #ffffff;
        }

    /* Иконки */
    .icon-corner {
        position: absolute;
        font-size: 30px;
        color: #000000;
        cursor: pointer;
    }

    .icon-top-right {
        top: 20px;
        right: 20px;
    }

    .icon-bottom-right {
        bottom: 20px;
        right: 20px;
    }

    .icon-link {
        color: inherit;
        text-decoration: none;
    }
    /* Стиль для заголовка над кнопками */
    .game-title {
        text-align: center;
        font-size: 24px;
        font-weight: 400;
        color: #333333;
        margin-bottom: 30px;
        line-height: 1.4;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .game-subtitle {
        display: block;
        margin-top: 5px;
        font-size: 20px;
        font-weight: 700;
        color: #000000;
    }
</style>

<div class="main-container">

    <!-- Иконка профиля (Верхний правый угол) -->
    <div class="icon-corner icon-top-right">
        <a href="#" class="icon-link">
            <i class="fa-regular fa-circle-user"></i>
        </a>
    </div>

    <div class="game-title">
        Игра для изучения осетинского языка
        <span class="game-subtitle">"Ирон детектив"</span>
    </div>

    <!-- Центральные кнопки -->
    <div class="button-group">
        <a href="#" class="btn-main btn-play">играть</a>
        <a href="#" class="btn-main btn-login">войти</a>
    </div>


    <!-- Иконка настроек/меню (Нижний правый угол) -->
    <div class="icon-corner icon-bottom-right">
        <a href="#" class="icon-link">
            <i class="fa-solid fa-gear"></i>
        </a>
        <a href="#" class="icon-link">
            <i class="fa-solid fa-gear"></i>
        </a>
    </div>

</div>

