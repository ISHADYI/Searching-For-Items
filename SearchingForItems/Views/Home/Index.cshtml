@page
@model dynamic
@{
    Layout = null;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
    * {
        box-sizing: border-box;
    }

    body{
        background-color: #141C30;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0;
        padding: 0;
        height: 100vh;
        font-family: 'Press Start 2P', cursive;
    }

    .main-container {
        position: relative;
        width: 420px;
        height: 740px;

        background-image: url('images/mainMenu.jpg');
        background-size: cover;
        background-position: center;

        border-radius: 4px;
        overflow: hidden;
    }

    .settings-btns {
        position: absolute;
        top: 25px;
        right: 25px; 
        display: flex;
        gap: 12px;
        z-index: 10; 
    }

    .setting-btn {
        position: relative;
        width: 38px; 
        aspect-ratio: 1 / 1;

        border: none;
        background-color: transparent;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
        padding: 0;

        /* image-rendering: pixelated; */
        transition: transform 0.1s ease, filter 0.1s ease;
    }

    .menu-btns {
        position: absolute;
        bottom: 12%;
        left: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 25px;
    }
    .menu-btn {
        width: 55%;
        aspect-ratio: 530 / 106;
        border: none;
        background-color: transparent;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        cursor: pointer;
        padding: 0;
        /* image-rendering: pixelated; */
        transition: transform 0.1s ease, filter 0.1s ease;
    }

    .play-btn {
        background-image: url('images/buttons/play-btn.png');
    }
    .rules-btn {
        background-image: url('images/buttons/rules-btn.png');
    }
    .sound-btn {
        background-image: url('images/buttons/sound-btn.png');
    }
    .music-btn {
        background-image: url('images/buttons/music-btn.png');
    }

    .account-btn{
        background-image: url('images/buttons/user-btn.png');
    }

    .music-btn.off::after {
        content: '';
        position: absolute;
        width: 120%;
        height: 4px;
        background-color: #d11e1e;
        top: 50%;
        left: -10%;
        transform: rotate(-45deg);
        border: 2px solid #141414;
        border-radius: 2px;
    }

    .menu-btn:hover {
        transform: scale(1.04);
        filter: brightness(1.1);
    }
    .menu-btn:active {
        transform: translateY(4px) scale(1.02);
        filter: brightness(0.90);
    }
    .setting-btn:hover {
        transform: scale(1.08);
        filter: brightness(1.1);
    }

    .setting-btn:active {
        transform: translateY(2px) scale(1.02);
        filter: brightness(0.90);
    }
    
</style>

<div class="main-container">
    <div class="settings-btns">
        <button class="setting-btn sound-btn" aria-label="Звуковые эффекты"></button>
        <button id="toggleMusic" class="setting-btn music-btn off" aria-label="Фоновая музыка"></button>
        <button class="setting-btn account-btn" aria-label="Аккаунт"></button>
    </div>
    <div class="menu-btns">
        <a href="/Game/Levels" class="menu-btn play-btn" aria-label="Играть"></a>
        <a href="#"  class="menu-btn rules-btn" aria-label="Правила"></a>
    </div>
</div>
<audio id="bgMenuMusic" loop>
    <source src="/audio/menu-theme.mp3" type="audio/mpeg">
</audio>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        const music = document.getElementById('bgMenuMusic');
        const musicBtn = document.getElementById('toggleMusic');

        music.volume = 0.1;

        musicBtn.addEventListener('click', function() {
            if (music.paused) {
                music.play();
                musicBtn.classList.remove('off');
            } else {
                music.pause();
                musicBtn.classList.add('off');
            }
        });
    });
</script>