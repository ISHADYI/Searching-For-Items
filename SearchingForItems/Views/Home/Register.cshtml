@{
    Layout = null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        background-image: url('/images/flag.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .register-container {
        width: 400px;
        background: rgba(255,255,255,0.95);
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.3);
    }

    .register-title {
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 7px;
        font-size: 16px;
    }

    .btn-register {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 7px;
        background: #ffd405;
        color: black;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-register:hover {
            background: #caa800;
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 15px;
        text-decoration: none;
        color: #555;
    }

        .back-link:hover {
            color: black;
        }

</style>

<div class="register-container">

    <div class="register-title">
        Регистрация
    </div>

    <form>

        <div class="form-group">
            <input type="text"
                   class="form-control"
                   placeholder="Введите логин">
        </div>

        <div class="form-group">
            <input type="password"
                   class="form-control"
                   placeholder="Введите пароль">
        </div>

        <div class="form-group">
            <input type="password"
                   class="form-control"
                   placeholder="Повторите пароль">
        </div>

        <button type="submit" class="btn-register">
            Зарегистрироваться
        </button>

    </form>

    <a href="/" class="back-link">
        ← Вернуться в меню
    </a>

</div>